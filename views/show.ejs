<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
    <h3>Listing Details </h3>
    </div>

    <div class="card col-6 offset-2">
        <img src="/<%= listing.image.url %>" class="card-img-top-show-img">
        <div class="card-body">
            <p class="card-text">
                <%= listing.description %> <br>
                &#8377: <%= listing.price %> <br>
                <%= listing.location %> <br>
                <%= listing.country %> <br>

            </p>
        </div>
    </div>

    <a href="/listings/<%= listing._id %>/edit">Edit this Listing</a>
    <br><br>
    <form  method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button>Delete this Listing</button>
    </form>
    </div>

    <div class="col-8 offset-3">
        <hr />
        <h4>Leave a review</h4>
        <form>
            <div>
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="5" id="rating" name="review[rating]">
            </div>
            <div>
                <label for="comment">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control"></textarea>
            </div>
            <button>Submit</button>
        </form>

    </div>

